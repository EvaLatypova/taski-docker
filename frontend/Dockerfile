# Используем официальный образ Node.js
FROM node:18-alpine

# Создаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы с зависимостями
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь остальной код проекта
COPY . .

# Собираем проект (создастся папка build)
RUN npm run build

# Устанавливаем пакет serve глобально для раздачи статики
RUN npm install -g serve

# Открываем порт 8000
EXPOSE 8000

# Запускаем сервер, указывая ему раздавать файлы из папки build на порту 8000
CMD ["serve", "-s", "build", "-l", "8000"]
